// TERRY.EXE God-word psalms: random words from TempleOS Vocab.DD, printed in colour and inscribed on the canvas.
// Each one ran in TERRY's TempleOS VM and its "God says:" line was read back off the screen.
// 2026-10-03 21:30 ET: oracle words "subdu medea similitude fall" inscribed
"\x24FG,BROWN\x24God says: subdu medea similitude fall\x24FG\x24\n";{CDC *dc=DCAlias;dc->color=BROWN;GrCircle(dc,91,230,5);GrPrint(dc,100,227,"subdu medea similitude fall");DCDel(dc);}
